#include <bits/stdc++.h> 
using namespace std; 
 
 
void swapElements(int &a, int &b) { 
    int temp = a; 
    a = b; 
    b = temp; 
} 
 
 
 
 
 
 
void selectionSort(int arr[], int n) { 
    for (int i = 0; i < n - 1; i++) { 
        int min_idx = i; 
        for (int j = i + 1; j < n; j++) { 
            if (arr[j] < arr[min_idx]) { 
                min_idx = j; 
            } 
        } 
 
        if (min_idx != i) { 
            swapElements(arr[i], arr[min_idx]); 
        } 
    } 
} 
 
 
void printArray(int arr[], int n) { 
    for (int i = 0; i < n; i++) { 
        cout << arr[i] << " "; 
    } 
    cout << endl; 
} 
 
int main() { 
    int arr[] = {64, 25, 12, 22, 11}; 
    int n = 5; 
 
    selectionSort(arr, n); 
 
    cout << "Sorted Array:   "; 
    printArray(arr, n); 
 
    return 0; 
}
